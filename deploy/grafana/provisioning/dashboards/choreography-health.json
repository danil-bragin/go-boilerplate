{
  "uid": "choreography-health",
  "title": "Choreography Health",
  "description": "Kafka consume/commit, dead-letter and outbox relay health across the order lifecycle services. Source: otel-collector Prometheus exporter (otel_* namespace).",
  "tags": ["boilerplate", "kafka", "outbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag (records) by topic/partition",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "otel_kafka_consumer_lag",
          "legendFormat": "{{job}} {{topic}}/p{{partition}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Records processed /s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, topic) (rate(otel_kafka_consumer_records_processed_total[5m]))",
          "legendFormat": "{{job}} {{topic}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Handler failures /s (records redelivered)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, topic) (rate(otel_kafka_consumer_records_failed_total[5m]))",
          "legendFormat": "{{job}} {{topic}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DLT produce /s (records dead-lettered)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, topic) (rate(otel_kafka_dlt_produced_total[5m]))",
          "legendFormat": "{{job}} {{topic}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dead-lettered (last 1h)",
      "description": "Anything > 0 needs the DLT redrive runbook (docs/operations.md).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(otel_kafka_dlt_produced_total[1h])) or vector(0)",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Commit failures /s (duplicate-delivery window widens)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, topic) (rate(otel_kafka_consumer_commit_failures_total[5m]))",
          "legendFormat": "{{job}} {{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox pending rows (publish backlog)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "otel_outbox_pending",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox published /s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(otel_outbox_published_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox publish error batches /s (rows stay pending, retried)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(otel_outbox_publish_errors_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CQRS handler errors /s (includes inbox-deduplicated retries)",
      "description": "No dedicated inbox-duplicate metric exists; handler status=error rate is the closest signal for processing trouble after dedup.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, handler) (rate(otel_cqrs_handler_calls_total{status!=\"ok\"}[5m]))",
          "legendFormat": "{{job}} {{handler}}"
        }
      ]
    }
  ]
}
