{
  "uid": "latency-tails",
  "title": "Latency tails (p50/p95/p99)",
  "description": "Per-signal latency quantiles from the rules-latency.yaml recording rules plus native-histogram heatmaps (raw series). All duration metrics are Prometheus NATIVE histograms — heatmap panels consume them directly (calculate: false), no le buckets involved. Exemplar toggle is on for raw-series queries: with OTEL_METRICS_EXEMPLAR_FILTER=trace_based and classic histograms exemplars pivot to Jaeger traces; the collector's pull exporter does not yet attach exemplars to NATIVE histograms, so expect them only in classic-fallback environments. SLO burn row mirrors deploy/prometheus/slo.yaml.",
  "tags": ["boilerplate", "latency", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "HTTP (edge)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP p50/p95/p99 by route (recording rules)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "job_route:http_server_duration_milliseconds:p50_5m", "legendFormat": "p50 {{job}} {{http_route}}" },
        { "refId": "B", "expr": "job_route:http_server_duration_milliseconds:p95_5m", "legendFormat": "p95 {{job}} {{http_route}}" },
        { "refId": "C", "expr": "job_route:http_server_duration_milliseconds:p99_5m", "legendFormat": "p99 {{job}} {{http_route}}" }
      ]
    },
    {
      "id": 2,
      "type": "heatmap",
      "title": "HTTP duration heatmap (native histogram)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "ms" },
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64 },
        "cellGap": 1
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(otel_http_server_duration_milliseconds[$__rate_interval]))", "exemplar": true, "format": "heatmap" }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "CQRS handlers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
