        { "refId": "B", "expr": "job_handler:cqrs_handler_duration_milliseconds:p95_5m", "legendFormat": "p95 {{job}} {{handler}}" },
        { "refId": "C", "expr": "job_handler:cqrs_handler_duration_milliseconds:p99_5m", "legendFormat": "p99 {{job}} {{handler}}" }
