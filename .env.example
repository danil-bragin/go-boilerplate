# ============================================================
# .env.example — Environment variables for the go-boilerplate stack
# Copy to .env and adjust values for your environment.
# All vars shown with their local/compose defaults.
# ============================================================


# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | console
LOG_FORMAT=json


# ── Postgres (pg.Config) ─────────────────────────────────────
# Primary (writer) DSN. Each service uses its own database:
#   gateway / orders / payments / notifications
PG_DSN=postgres://app:app@localhost:5432/gateway?sslmode=disable
# Optional read replica DSN. Leave empty to use the writer pool.
PG_READER_DSN=
# Connection pool tuning (optional — defaults are sensible for dev).
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_MAX_CONN_LIFETIME=30m
PG_MAX_CONN_IDLE_TIME=5m
PG_HEALTH_CHECK_PERIOD=1m


# ── Kafka / Redpanda (kafka.Config) ──────────────────────────
# Comma-separated list of Kafka seed brokers.
KAFKA_BROKERS=localhost:19092
# Human-readable client ID logged by brokers.
KAFKA_CLIENT_ID=app
# Consumer group ID — overridden per-consumer inside each service.
KAFKA_GROUP_ID=


# ── HTTP server (httpserver.Config — gateway only) ───────────
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
HTTP_HANDLER_TIMEOUT=30s


# ── OpenTelemetry / Tracing (telemetry.Config) ───────────────
OTEL_SERVICE_NAME=gateway
# gRPC endpoint of the OTel Collector (host:port, no scheme).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Set to true to enable trace export; false = no-op provider.
OTEL_ENABLED=false


# ── Redis (cache.Config) ─────────────────────────────────────
# Comma-separated list of Redis addresses.
REDIS_ADDRS=localhost:6379
CACHE_L1_CAPACITY=10000
CACHE_DEFAULT_TTL=5m
CACHE_TTL_JITTER=0.1


# ── S3 / MinIO (blob.Config) ─────────────────────────────────
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app
S3_USE_SSL=false
S3_REGION=us-east-1


# ── Gateway auth (gateway.Config) ────────────────────────────
# Set to true ONLY for local dev/demo — all endpoints become open.
GATEWAY_AUTH_DISABLED=true
# Keycloak JWKS URL (used when GATEWAY_AUTH_DISABLED=false).
GATEWAY_JWKS_URL=http://localhost:8180/realms/app/protocol/openid-connect/certs
GATEWAY_JWKS_ISSUER=http://localhost:8180/realms/app
GATEWAY_JWKS_AUDIENCE=gateway


# ── Gateway topics ────────────────────────────────────────────
GATEWAY_COMMANDS_TOPIC=orders.commands
GATEWAY_ORDERS_EVENTS_TOPIC=orders.events
GATEWAY_PAYMENTS_EVENTS_TOPIC=payments.events


# ── Orders topics ─────────────────────────────────────────────
ORDERS_COMMANDS_TOPIC=orders.commands


# ── Payments topics ───────────────────────────────────────────
# Topic the payments service consumes (OrderCreated events).
ORDERS_EVENTS_TOPIC=orders.events


# ── Notifications topics ──────────────────────────────────────
# Topic the notifications service consumes (PaymentProcessed events).
PAYMENTS_EVENTS_TOPIC=payments.events


# ── Outbox relay tuning (outbox.RelayConfig) ─────────────────
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1s
