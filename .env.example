# ============================================================
# .env.example — Environment variables for the go-boilerplate stack
# Copy to .env and adjust values for your environment.
# All vars shown with their local/compose defaults.
#
# SECURITY NOTE — reading secrets from files (production pattern):
# ----------------------------------------------------------------
# The caarlos0/env library supports reading environment variables from files
# via the `file:"true"` struct tag. When a variable is tagged with
# `file:"true"`, caarlos0/env looks for a companion env var named <VAR>_FILE
# and reads the secret from the path it points to. This keeps raw credentials
# out of the process environment and makes it safe to mount Docker/K8s secrets
# as files.
#
# Example (in the Go config struct):
#   PGPassword string `env:"PG_PASSWORD,file"` // reads PG_PASSWORD_FILE
#
# Example (in production environment):
#   PG_PASSWORD_FILE=/run/secrets/pg_password   (Docker secret mounted here)
#   S3_SECRET_KEY_FILE=/run/secrets/s3_secret   (K8s secret volume mount)
#
# The variables below marked "SECRET" should be provided via *_FILE in
# production. The .env values here are insecure defaults for local dev only.
# ============================================================


# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | console
LOG_FORMAT=json


# ── Postgres (pg.Config) ─────────────────────────────────────
# Primary (writer) DSN. Each service uses its own database:
#   gateway / orders / payments / notifications
# SECRET: In production provide PG_DSN_FILE=/run/secrets/pg_dsn instead.
# The DSN embeds the DB password; never commit a production DSN to source control.
PG_DSN=postgres://app:app@localhost:5432/gateway?sslmode=disable
# Optional read replica DSN. Leave empty to use the writer pool.
PG_READER_DSN=
# Connection pool tuning (optional — defaults are sensible for dev).
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_MAX_CONN_LIFETIME=30m
PG_MAX_CONN_IDLE_TIME=5m
PG_HEALTH_CHECK_PERIOD=1m


# ── Kafka / Redpanda (kafka.Config) ──────────────────────────
# Comma-separated list of Kafka seed brokers.
KAFKA_BROKERS=localhost:19092
# Human-readable client ID logged by brokers.
KAFKA_CLIENT_ID=app
# Consumer group ID — overridden per-consumer inside each service.
KAFKA_GROUP_ID=


# ── HTTP server (httpserver.Config — gateway only) ───────────
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
HTTP_HANDLER_TIMEOUT=30s


# ── OpenTelemetry / Tracing (telemetry.Config) ───────────────
OTEL_SERVICE_NAME=gateway
# gRPC endpoint of the OTel Collector (host:port, no scheme).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Set to true to enable trace export; false = no-op provider.
OTEL_ENABLED=false


# ── Redis (cache.Config) ─────────────────────────────────────
# Comma-separated list of Redis addresses.
REDIS_ADDRS=localhost:6379
CACHE_L1_CAPACITY=10000
CACHE_DEFAULT_TTL=5m
CACHE_TTL_JITTER=0.1


# ── S3 / SeaweedFS (blob.Config) ─────────────────────────────
# SECRET: In production provide S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
# and S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key instead of plain env vars.
# Local dev creds match deploy/seaweedfs/s3.json (docker-compose seaweedfs).
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=seaweedadmin
S3_SECRET_KEY=seaweedadmin
S3_BUCKET=app
S3_USE_SSL=false
S3_REGION=us-east-1
# Path-style addressing (http://host:port/bucket/key) — required for local
# S3-compatible stores (SeaweedFS, LocalStack); set false for AWS S3.
S3_USE_PATH_STYLE=true


# ── Gateway auth (gateway.Config) ────────────────────────────
# Set to true ONLY for local dev/demo — all endpoints become open.
GATEWAY_AUTH_DISABLED=true
# Keycloak JWKS URL (used when GATEWAY_AUTH_DISABLED=false).
GATEWAY_JWKS_URL=http://localhost:8180/realms/app/protocol/openid-connect/certs
GATEWAY_JWKS_ISSUER=http://localhost:8180/realms/app
GATEWAY_JWKS_AUDIENCE=gateway


# ── Gateway topics ────────────────────────────────────────────
GATEWAY_COMMANDS_TOPIC=orders.commands
GATEWAY_ORDERS_EVENTS_TOPIC=orders.events
GATEWAY_PAYMENTS_EVENTS_TOPIC=payments.events


# ── Orders topics ─────────────────────────────────────────────
ORDERS_COMMANDS_TOPIC=orders.commands


# ── Payments topics ───────────────────────────────────────────
# Topic the payments service consumes (OrderCreated events).
ORDERS_EVENTS_TOPIC=orders.events


# ── Notifications topics ──────────────────────────────────────
# Topic the notifications service consumes (PaymentProcessed events).
PAYMENTS_EVENTS_TOPIC=payments.events


# ── Outbox relay tuning (outbox.RelayConfig) ─────────────────
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1s


# ── Go runtime tuning ─────────────────────────────────────────
#
# GOMEMLIMIT sets a soft heap limit so the GC trims memory before the
# Linux cgroup OOM-killer fires.  Set to ~90% of the container's hard
# memory limit (deploy.resources.limits.memory in docker-compose /
# resources.limits.memory in Kubernetes).
#
# Example: container limit = 512 MiB  →  GOMEMLIMIT = 460MiB (≈90%)
# Example: container limit = 1 GiB    →  GOMEMLIMIT = 920MiB
# Example: container limit = 2 GiB    →  GOMEMLIMIT = 1800MiB
#
# The docker-compose.yml services already set GOMEMLIMIT=460MiB to match
# their deploy.resources.limits.memory=512M.  Update both together.
#
# Units: B, KiB, MiB, GiB, TiB (no spaces around the value).
GOMEMLIMIT=460MiB
#
# GOMAXPROCS is set automatically at startup via go.uber.org/automaxprocs,
# which reads the container CPU quota from the Linux cgroup.  Go 1.25+
# also does this natively when GOMAXPROCS is unset, so automaxprocs is
# belt-and-suspenders.  Only set this to override automaxprocs explicitly.
#GOMAXPROCS=2
#
# Use whole-number CPU limits (cpus: "1.0", "2.0", …) in deploy.resources
# to avoid CFS throttling artefacts from fractional quotas.
# Each service runs in its own container and therefore has its own env
# namespace — no per-service env-prefix is needed.  To run multiple
# services in a single process, pass distinct configs explicitly (as the
# e2e test does) rather than relying on env variables.
